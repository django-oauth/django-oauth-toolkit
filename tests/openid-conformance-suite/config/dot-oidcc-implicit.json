{
    "alias": "dot-implicit",
    "description": "django-oauth-toolkit tests/app/idp (dot-implicit)",
    "server": {
        "discoveryUrl": "https://dot-idp/o/.well-known/openid-configuration"
    },
    "client": {
        "client_id": "openid-conformance-suite-implicit-1",
        "client_secret": "openid-conformance-suite-implicit-secret-1"
    },
    "client2": {
        "client_id": "openid-conformance-suite-implicit-2",
        "client_secret": "openid-conformance-suite-implicit-secret-2"
    },
    "browser": [
        {
            "match": "https://dot-idp/o/authorize/*",
            "tasks": [
                {
                    "task": "Login",
                    "optional": true,
                    "match": "https://dot-idp/accounts/login/*",
                    "commands": [
                        [
                            "text",
                            "id",
                            "id_username",
                            "conformance"
                        ],
                        [
                            "text",
                            "id",
                            "id_password",
                            "conformance-password"
                        ],
                        [
                            "click",
                            "css",
                            "button[type='submit']"
                        ]
                    ]
                },
                {
                    "task": "Consent",
                    "optional": true,
                    "match": "https://dot-idp/o/authorize/*",
                    "commands": [
                        [
                            "click",
                            "css",
                            "input[name='allow']",
                            "optional"
                        ]
                    ]
                },
                {
                    "task": "Verify Complete",
                    "match": "*/test/*/callback*",
                    "commands": [
                        [
                            "wait",
                            "id",
                            "submission_complete",
                            10
                        ]
                    ]
                }
            ]
        },
        {
            "match": "https://dot-idp/o/logout/*",
            "tasks": [
                {
                    "task": "Confirm logout",
                    "optional": true,
                    "match": "https://dot-idp/o/logout/*",
                    "commands": [
                        [
                            "click",
                            "css",
                            "input[name='allow']",
                            "optional"
                        ]
                    ]
                },
                {
                    "task": "Verify Complete",
                    "match": "*/test/*/post*"
                }
            ]
        }
    ],
    "override": {
        "oidcc-prompt-login": {
            "browser": [
                {
                    "comment": "screenshots the re-login prompt during the second authorization",
                    "match": "https://dot-idp/o/authorize/*",
                    "tasks": [
                        {
                            "task": "Login",
                            "optional": true,
                            "match": "https://dot-idp/accounts/login/*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*",
                                    10,
                                    "Log In",
                                    "update-image-placeholder-optional"
                                ],
                                [
                                    "text",
                                    "id",
                                    "id_username",
                                    "conformance"
                                ],
                                [
                                    "text",
                                    "id",
                                    "id_password",
                                    "conformance-password"
                                ],
                                [
                                    "click",
                                    "css",
                                    "button[type='submit']"
                                ]
                            ]
                        },
                        {
                            "task": "Consent",
                            "optional": true,
                            "match": "https://dot-idp/o/authorize/*",
                            "commands": [
                                [
                                    "click",
                                    "css",
                                    "input[name='allow']",
                                    "optional"
                                ]
                            ]
                        },
                        {
                            "task": "Verify Complete",
                            "match": "*/test/*/callback*",
                            "commands": [
                                [
                                    "wait",
                                    "id",
                                    "submission_complete",
                                    10
                                ]
                            ]
                        }
                    ]
                }
            ]
        },
